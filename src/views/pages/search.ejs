<p class='fw-bold'><%- t('lookingForPageEdit', { searchtitle: encodeURIComponent(searchtitle) }) %></p>
<h5><%= t('titleMatch') %></h5>
<ul class="list-group list-group-flush">
    <% for (let i = 0; i < resultTitle.length; i++) { %>
        <li class="list-group-item">
            <a href='/w/<%= resultTitle[i].title %>'><%= resultTitle[i].title %></a>
        </li>
    <% } %>
</ul>
<% if (resultTitle.length == 0) { %>
    <p><%= t('noResults') %></p>
<% } %>
<br>
<h5><%= t('contentMatch') %></h5>
<ul class="list-group list-group-flush">
    <% for (let i = 0; i < resultContent.length; i++) { %>
        <li class="list-group-item">
            <a href='/w/<%= resultContent[i].title %>'><%= resultContent[i].title %></a>
            <% if (searchMode == "enhanced")  {%>
                <!-- TODO WITH FRONTEND REFACTOR: ADD SOME STYLE -->
                <p class="hitCroppedContent"><%- sanitizeHTML(resultContent[i].content) %></p>
            <% } %>
        </li>
    <% } %>
</ul>
<% if (resultContent.length == 0) { %>
    <p><%= t('noResults') %></p>
<% } %>
<br>
<ul class="pagination">
    <% if (0 < from) { %>
        <% var prevlink = `/search/?q=${encodeURIComponent(searchtitle)}&from=${Math.max(0, from - 10)}` %>
        <li class="page-item">
            <a class="page-link" href=<%= prevlink %> aria-label="Previous">
                <%= t('previous') %>
            </a>
        </li>
    <% } %>
    <% if (resultTitle.length == 10 || resultContent.length == 10) { %>
        <% var nextlink = `/search/?q=${encodeURIComponent(searchtitle)}&from=${from + 10}` %>
        <li class="page-item">
            <a class="page-link" href=<%= nextlink %> aria-label="Next">
                <%= t('next') %>
            </a>
        </li>
    <% } %>
</ul>
